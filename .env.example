# Copie para .env SOMENTE em desenvolvimento. Nunca commite valores reais.
# Em produção estes valores são App Settings que apontam para o Azure Key Vault.
APP_ENV=development
# SECRET_KEY=            (gerada automaticamente em instance/ no modo dev)
# FERNET_KEY=            (gerada automaticamente em instance/ no modo dev)
# ADMIN_PASSWORD=        (cria o usuário "admin" na primeira subida)
# INTEGRATION_API_KEY=   (chave do robô UiPath / componente de Visão)
# TUTOR_API_URL=         (https://... endpoint do tutor IA da disciplina de GenAI)
# PRIVACY_CONTACT=       (e-mail de contato exibido no Aviso de Privacidade)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
SEED_DEMO=1
